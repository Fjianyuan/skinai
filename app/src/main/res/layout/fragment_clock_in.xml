<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="每日打卡"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_today_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025年4月18日"
                android:textSize="14sp"
                android:textColor="#777777" />
        </LinearLayout>

        <!-- 日历卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连续打卡"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                        
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                        
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/streak_days_bg"
                        android:padding="8dp">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_streak"
                            android:layout_marginEnd="6dp" />
                            
                        <TextView
                            android:id="@+id/tv_streak_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0天"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 日历网格 -->
                <LinearLayout
                    android:id="@+id/calendar_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    
                    <!-- 星期标题行 -->
                    <LinearLayout
                        android:id="@+id/calendar_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="日"
                            android:textColor="#F44336"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="一"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="二"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="三"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="四"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="五"
                            android:textColor="#666666"
                            android:gravity="center"
                            android:textSize="12sp" />
                            
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="六"
                            android:textColor="#4CAF50"
                            android:gravity="center"
                            android:textSize="12sp" />
                    </LinearLayout>
                    
                    <!-- 日期行会由代码动态添加 -->
                    
                </LinearLayout>

                <!-- 打卡按钮 -->
                <Button
                    android:id="@+id/clock_in_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="今日打卡"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="@drawable/button_primary"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- 查看历史记录按钮 -->
                <Button
                    android:id="@+id/btn_view_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看打卡历史"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="@drawable/button_primary"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 今日记录 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记录皮肤状态"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp" />

                <!-- 皮肤照片上传 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上传照片"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <!-- 照片列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_photos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <!-- 添加照片按钮 -->
                    <Button
                        android:id="@+id/btn_add_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加照片"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:padding="8dp"
                        android:drawableStart="@drawable/ic_add_photo"
                        android:drawablePadding="8dp"
                        android:background="@drawable/button_secondary"
                        android:layout_gravity="center_horizontal" />
                </LinearLayout>

                <!-- 皮肤状态选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="皮肤状态"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/status_good"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="良好"
                            android:textColor="#4CAF50" />

                        <RadioButton
                            android:id="@+id/status_normal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="一般"
                            android:textColor="#FF9800" />

                        <RadioButton
                            android:id="@+id/status_bad"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="不佳"
                            android:textColor="#F44336" />
                    </RadioGroup>
                </LinearLayout>

                <!-- 备注信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="备注信息"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/notes_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/edit_text_background"
                        android:gravity="top"
                        android:hint="请输入今日皮肤状态备注..."
                        android:inputType="textMultiLine"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 保存按钮 -->
                <Button
                    android:id="@+id/save_record_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="保存记录"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:background="@drawable/button_primary"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>